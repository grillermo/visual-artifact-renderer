          "props": {
            "file": "src/retry.ts",
            "language": "typescript",
            "startLine": 40,
            "code": "export function retry(job: Job) {\n  const pending = new Map()\n  pending.set(job.id, job)\n  const maxAttempts = 3\n  for (let attempt = 0; attempt < maxAttempts; attempt++) {\n    if (run(job)) return true\n  }\n  pending.delete(job.id)\n  return false\n}",
            "annotations": [
              {
                "line": 41,
                "end": 43,
                "title": "Bound pending work",
                "body": "This state lives only for the job.",
                "tone": "idea",
                "text": "new Map()"
              },
              {
                "line": 47,
                "end": 48,
                "title": "Release it on failure",
                "tone": "risk"
              }
            ]
          }
        }
      ]
