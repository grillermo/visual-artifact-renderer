              "wf -> coder : build",
              "wf -> rev : reviews one at a time",
              "spawn -> lead : one lead per worktree",
              "lead --> coder : delegates"
            ],
            "dashed": "delegation at run time",
            "grid": [
              "| prof | alias | roles | . |",
              "| spawn | lead | coder | rev |",
              "| . | . | wf | . |"
            ]
          }
        },
        {
          "type": "prose",
          "props": {
            "tone": "muted",
            "content": "**Roles:** lead, coder, reviewer, oracle, researcher, scribe, qa. **Workflows:** saved plan and build scripts. An install script copies them, because Pi's workflow loader ignores symlinks. **spawn-lead:** a skill and command that creates a Herdr workspace with one lead agent in its own git worktree. The lead delegates the work."
          }
        }
      ]
    },
