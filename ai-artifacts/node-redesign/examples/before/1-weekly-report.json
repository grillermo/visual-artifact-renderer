  "data": {
    "fixes": [
      {
        "problem": "Lock names",
        "what happened": "update wrote -deps locks but the catalog expects -lock, so apply refused to replace them",
        "fix": "update now uses -lock",
        "status": "fixed"
      },
      {
        "problem": "Release tags",
        "what happened": "plannotator was locked as v0.28.10 and stopped matching its npm siblings",
        "fix": "the v is dropped",
        "status": "fixed"
      },
      {
        "problem": "Settings",
        "what happened": "undefined compaction fields were written into settings.json",
        "fix": "they are dropped first",
        "status": "fixed"
      },
      {
        "problem": "Doctor",
        "what happened": "check details were built eagerly",
        "fix": "they are built only when needed",
        "status": "fixed"
      },
      {
        "problem": "Pi 1.0.4",
        "what happened": "new version, new tool-card API",
        "fix": "pinned and applied",
        "status": "fixed"
      }
    ],
    "loops": [
      {
        "item": "Herdr ui.accent",
        "status": "warn",
        "notes": "Remove it from the agents2 base config so apply stops freezing the Mosaic tint."
      },
      {
        "item": "Two Herdr sessions",
        "status": "warn",
