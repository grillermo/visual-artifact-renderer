    {
      "type": "chapter",
      "props": {
        "kicker": "Steps",
        "title": "A line of steps",
        "deck": "For a short process where order matters. 2 to 7 steps, 1 or 2 marked key."
      },
      "children": [
        {
          "type": "steps",
          "props": {
            "items": [
              {
                "title": "Session grows",
                "body": "Context passes 70%."
              },
              {
                "title": "Memory saves first",
                "body": "OptMem stores durable facts.",
                "tag": "New order",
                "key": true
              },
              {
                "title": "Haiku summarises",
                "body": "Up to 24K tokens of summary."
              },
              {
                "title": "Next session wakes",
                "body": "OptMem adds the wake view."
              }
            ]
          }
        }
      ]
    },
